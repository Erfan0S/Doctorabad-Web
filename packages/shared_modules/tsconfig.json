{
  "extends": "@repo/typescript-config/react-library.json",
  "plugins": [
    {
      "name": "next"
    }
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "paths": {
    "@/*": ["./*"],
    "src/*": ["./*"],
    "react": [ "./node_modules/@types/react" ]
  },
  "include": ["**/*.ts", "**/*.tsx"], 
  "exclude": ["node_modules"]
}
  