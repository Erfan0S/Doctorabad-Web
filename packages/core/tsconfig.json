{
  "extends": "@repo/typescript-config/base",
  "plugins": [
    {
      "name": "next"
    }
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "paths": {
    "@/*": ["./*"],
    "src/*": ["./*"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
